# MongoDB connection URI.
# For local development, you can use: mongodb://localhost:27017/treeApp
# For production, use your MongoDB Atlas connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/treeApp?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/treeApp

# Port for the server to listen on.
PORT=3003

# Mailgun API key and domain for sending emails.
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain

# JWT secret for signing tokens.
JWT_SECRET=your_jwt_secret

# Admin email and password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password

# Session secret for session management.
SESSION_SECRET=your_session_secret

# Node environment.
NODE_ENV=development
